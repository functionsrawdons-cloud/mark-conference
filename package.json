{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "description": "Rawdons Conference Planning and Operations Desktop Platform",
  "author": "Rawdons Operations",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist server.js dist-electron dist-exe",
    "lint": "tsc --noEmit",
    "desktop:start": "node node_modules/vite/bin/vite.js build && node node_modules/electron/cli.js electron/main.cjs",
    "desktop:serve": "node standalone/server.cjs",
    "build:exe": "node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/cli.js --win portable",
    "build:installer": "node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/cli.js --win nsis",
    "build:node-exe": "node node_modules/vite/bin/vite.js build && npx @yao-pkg/pkg standalone/server.cjs --targets node18-win-x64 --output dist-exe/RawdonsConference.exe",
    "package:windows": "node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/cli.js --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.rawdons.conferenceplanner",
    "productName": "Rawdons Conference Platform",
    "copyright": "Copyright © Rawdons Conference Operations",
    "electronVersion": "33.2.1",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rawdons Conference Operations"
    },
    "portable": {
      "artifactName": "RawdonsConference-Portable.exe"
    }
  }
}
